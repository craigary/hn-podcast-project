{
  "name": "podcast-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "gen": "bun run --cwd apps/generator gen",
    "backfill": "bun run --cwd apps/generator backfill",
    "backfill:vps": "bash scripts/vps-backfill.sh",
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "deploy": "bun run --cwd apps/web deploy",
    "preview": "bun run --cwd apps/web preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check"
  },
  "overrides": {
    "vite": "^8.0.0"
  },
  "trustedDependencies": [
    "@ffmpeg-installer/darwin-arm64",
    "esbuild",
    "node-pty",
    "protobufjs",
    "sharp",
    "tree-sitter-bash",
    "workerd"
  ],
  "devDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "sharp": "^0.34.5"
  }
}

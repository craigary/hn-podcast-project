{
  "name": "podcast-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "gen": "bun run --filter generator gen",
    "backfill": "bun run --filter generator backfill",
    "backfill:vps": "bash scripts/vps-backfill.sh",
    "dev": "bun run --filter web dev",
    "build": "bun run --filter web build",
    "deploy": "bun run --filter web deploy",
    "preview": "bun run --filter web preview",
    "typecheck": "tsc --noEmit -p apps/generator/tsconfig.json && tsc --noEmit -p packages/config/tsconfig.json && bun run --filter web check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "overrides": {
    "vite": "^8.0.0"
  },
  "trustedDependencies": [
    "@ffmpeg-installer/darwin-arm64",
    "esbuild",
    "node-pty",
    "protobufjs",
    "sharp",
    "tree-sitter-bash",
    "workerd"
  ],
  "devDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^5.9.3"
  }
}

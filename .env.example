# AI
SUPERLINKED_API_KEY=
EXA_API_KEY=

# Cloudflare KV（Exa / 封面 prompt 缓存）
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=

# Cloudflare R2（S3 API）
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=
CF_R2_PUBLIC_URL=

# R2 对象前缀（可选）。默认空，写到 episodes/<期号>/…
# 实验分支建议设成 preview/<branch>，只写自己的目录，不覆盖线上音频和封面
# R2_KEY_PREFIX=preview/mimo-tts

# Workers AI 封面（可选，默认 flux-2-dev / 2048）
# IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
# IMAGE_STEPS=4

# 本地调试（可选）
# LOCAL_KV=1
# LOCAL_AI_BASE_URL=http://127.0.0.1:3425
# LOCAL_AI_API_KEY=

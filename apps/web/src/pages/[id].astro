---
import Layout from '../layouts/Layout.astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import IconLucidePlay from '~icons/lucide/play'
import IconLucidePause from '~icons/lucide/pause'
import IconSimpleIconsYcombinator from '~icons/simple-icons/ycombinator'
import { podcastConfig } from '@hn/config'

type Episode = CollectionEntry<'episodes'>
type Chapter = NonNullable<Episode['data']['chapters']>[number]
type Link = NonNullable<Episode['data']['links']>[number]
type TranscriptLine = NonNullable<Episode['data']['transcript']>[number]

export async function getStaticPaths() {
  const episodes = await getCollection('episodes')
  return episodes.map((ep: Episode) => ({
    params: { id: ep.id },
    props: { episode: ep }
  }))
}

const { episode } = Astro.props as { episode: Episode }
const { id: epId, title, date, duration, audioUrl, coverImage, chapters, links, transcript } = episode.data

// SEO metadata
const description = episode.data.desc || `收听 ${podcastConfig.podcast.name} 第 ${epId} 期：${title}`
const publishedTime = new Date(date).toISOString()

const episodes = await getCollection('episodes')
const sorted = episodes.sort((a: Episode, b: Episode) => b.data.id - a.data.id)
const currentIndex = sorted.findIndex((e: Episode) => e.id === episode.id)
const prevEp = sorted[currentIndex + 1]
const nextEp = sorted[currentIndex - 1]
---

<Layout
  title={`EP${epId}: ${title}`}
  description={description}
  image={coverImage}
  type="article"
  publishedTime={publishedTime}
  author={podcastConfig.podcast.name}
>
  <main class="max-w-175 mx-auto px-5 md:px-8 py-8 pb-16">
    <!-- Back link -->
    <a
      href="/"
      class="inline-block text-sm text-tx3 hover:text-tx1 transition-colors mb-8 no-underline"
    >
      ← 返回首页
    </a>

    <!-- Episode header -->
    <header class="mb-8">
      <span class="font-mono-label text-xs tracking-[0.2em] text-ac uppercase mb-4 block">EP{epId}</span>
      <div class="flex gap-6 items-start">
        {
          coverImage && (
            <Image
              src={coverImage}
              alt={title}
              width={640}
              height={640}
              loading="eager"
              class="w-32 h-32 md:w-40 md:h-40 object-cover rounded-lg shrink-0 shadow-lg"
              transition:name={`episode-cover-${epId}`}
            />
          )
        }
        <div class="flex-1 min-w-0">
          <h1 class="font-serif-display text-3xl md:text-4xl text-tx1 leading-tight mb-3" transition:name={`episode-title-${epId}`}>
            {title}
          </h1>
          <div class="flex items-center gap-3 font-mono-label text-xs text-tx4 mb-4">
            <time>{date}</time>
            {
              duration && (
                <>
                  <span>·</span>
                  <span>{duration}</span>
                </>
              )
            }
          </div>
          {
            audioUrl && (
              <button
                id="episode-play-btn"
                data-audio-url={audioUrl}
                data-episode-title={`EP${epId} — ${title}`}
                class="inline-flex items-center gap-2 bg-ac text-ac-on px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-ac-h transition-colors"
                aria-label={`播放单集 ${epId}: ${title}`}
              >
                <IconLucidePlay id="episode-play-icon" class="w-4 h-4" />
                <IconLucidePause id="episode-pause-icon" class="w-4 h-4 hidden" />
                <span id="episode-play-text">播放</span>
              </button>
            )
          }
        </div>
      </div>
    </header>

    <!-- Inline player area
    {audioUrl && (
      <div class="border border-bd rounded-lg p-4 mb-10 text-center">
        <p class="text-sm text-tx4">点击上方按钮开始播放</p>
      </div>
    )} -->

    <!-- Description -->
    {
      episode.data.desc && (
        <section class="mb-10">
          <h2 class="font-mono-label text-xs tracking-[0.2em] text-tx4 uppercase mb-5">
            About This Episode
          </h2>
          <p class="text-base text-tx2 leading-relaxed">
            {episode.data.desc}
          </p>
        </section>
      )
    }

    <!-- Chapters -->
    {
      chapters && chapters.length > 0 && (
        <section class="mb-10">
          <h2 class="font-mono-label text-xs tracking-[0.2em] text-tx4 uppercase mb-5">
            Chapters
          </h2>
          <div class="space-y-4">
            {chapters.map((chapter: Chapter) => (
              <article class="border-l-2 border-ac/30 pl-4 hover:border-ac transition-colors">
                <button
                  class="chapter-seek text-left w-full group"
                  data-time={chapter.start}
                  title="跳转到此章节"
                >
                  <div class="flex items-start gap-3 mb-2">
                    <span class="font-mono-label text-[11px] text-tx4 group-hover:text-ac transition-colors mt-0.5 shrink-0">
                      {Math.floor(chapter.start / 60).toString().padStart(2, '0')}:{Math.floor(chapter.start % 60).toString().padStart(2, '0')}
                    </span>
                    <h3 class="text-tx1 font-medium text-base group-hover:text-ac transition-colors">
                      {chapter.title}
                    </h3>
                  </div>
                  <p class="text-sm text-tx3 leading-relaxed">{chapter.desc}</p>
                </button>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <!-- Links -->
    {
      links && links.length > 0 && (
        <section class="mb-10">
          <h2 class="font-mono-label text-xs tracking-[0.2em] text-tx4 uppercase mb-5">
            Links
          </h2>
          <div class="space-y-4">
            {links.map((link: Link) => (
              <article class="border-l-2 border-ac/30 pl-4 hover:border-ac transition-colors">
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-tx1 font-medium text-base hover:text-ac transition-colors no-underline block mb-2"
                >
                  {link.title}
                </a>
                <div class="flex items-center gap-3 text-xs text-tx4">
                  <a
                    href={link.hnUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-ac transition-colors no-underline inline-flex items-center gap-1"
                    aria-label={`在 Hacker News 上查看 ${link.title} 的讨论`}
                  >
                    <IconSimpleIconsYcombinator class="w-3 h-3" />
                    HN 讨论
                  </a>
                  {/* {link.points && (
                    <>
                      <span>·</span>
                      <span>{link.points} points</span>
                    </>
                  )} */}
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <!-- Transcript toggle -->
    {
      transcript && transcript.length > 0 && (
        <section class="mb-10">
          <button
            id="transcript-toggle"
            class="w-full text-left border border-bd rounded-lg px-4 py-3 text-sm text-tx2 hover:border-tx4 transition-colors"
            aria-expanded="false"
            aria-controls="transcript-content"
          >
            <span id="transcript-toggle-text">展开对话文本</span>
            <span id="transcript-toggle-icon" aria-hidden="true"> ▼</span>
          </button>
          <div id="transcript-content" class="hidden mt-4 space-y-5 px-1" role="region" aria-label="对话文本">
            {transcript.map((line: TranscriptLine) => (
              <div class="flex gap-2 items-start" data-start={line.start} data-end={line.end}>
                {line.start !== undefined && (
                  <button
                    class="transcript-seek shrink-0 font-mono-label text-[11px] text-tx4 hover:text-ac transition-colors mt-0.5 cursor-pointer"
                    data-time={line.start}
                    title="跳转到此处"
                  >
                    {Math.floor(line.start / 60).toString().padStart(2, '0')}:{Math.floor(line.start % 60).toString().padStart(2, '0')}
                  </button>
                )}
                <div>
                  <span class="font-medium text-ac">{line.speaker}:</span>
                  <span class="text-tx2 ml-1">{line.text}</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Episode navigation -->
    <nav class="flex flex-col sm:flex-row items-stretch gap-3 border-t border-bd pt-6" aria-label="单集导航">
      {
        prevEp ? (
          <a
            href={`/${prevEp.id}`}
            class="flex-1 px-4 py-3 text-sm text-tx2 hover:text-tx1 hover:border-ac bg-sf-card border border-bd rounded-lg transition-all no-underline"
            rel="prev"
          >
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <div class="min-w-0 flex-1">
                <div class="text-xs text-tx4 mb-0.5">上一期</div>
                <div class="line-clamp-2">EP{prevEp.data.id}: {prevEp.data.title}</div>
              </div>
            </div>
          </a>
        ) : (
          <div class="flex-1 px-4 py-3 text-sm text-tx4 bg-sf-card border border-bd rounded-lg opacity-50">
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <div>
                <div class="text-xs mb-0.5">上一期</div>
                <div>没有更多</div>
              </div>
            </div>
          </div>
        )
      }
      {
        nextEp ? (
          <a
            href={`/${nextEp.id}`}
            class="flex-1 px-4 py-3 text-sm text-tx2 hover:text-tx1 hover:border-ac bg-sf-card border border-bd rounded-lg transition-all no-underline sm:text-right"
            rel="next"
          >
            <div class="flex items-start gap-2 sm:flex-row-reverse">
              <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <div class="min-w-0 flex-1">
                <div class="text-xs text-tx4 mb-0.5">下一期</div>
                <div class="line-clamp-2">EP{nextEp.data.id}: {nextEp.data.title}</div>
              </div>
            </div>
          </a>
        ) : (
          <div class="flex-1 px-4 py-3 text-sm text-tx4 bg-sf-card border border-bd rounded-lg opacity-50 sm:text-right">
            <div class="flex items-start gap-2 sm:flex-row-reverse">
              <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <div>
                <div class="text-xs mb-0.5">下一期</div>
                <div>最新一期</div>
              </div>
            </div>
          </div>
        )
      }
    </nav>
  </main>

  <script is:inline>
    ;(function () {
      var btn = document.getElementById('transcript-toggle')
      var content = document.getElementById('transcript-content')
      var toggleText = document.getElementById('transcript-toggle-text')
      var toggleIcon = document.getElementById('transcript-toggle-icon')
      if (!btn || !content || !toggleText || !toggleIcon) return
      btn.addEventListener('click', function () {
        var isHidden = content.classList.toggle('hidden')
        btn.setAttribute('aria-expanded', isHidden ? 'false' : 'true')
        toggleText.textContent = isHidden ? '展开对话文本' : '收起对话文本'
        toggleIcon.textContent = isHidden ? ' ▼' : ' ▲'
      })

      // Transcript seek: click timestamp to jump audio
      var episodePlayBtn = document.getElementById('episode-play-btn')
      content.addEventListener('click', function (e) {
        var target = e.target
        while (target && target !== content) {
          if (target.classList && target.classList.contains('transcript-seek')) {
            var time = parseFloat(target.getAttribute('data-time'))
            if (isNaN(time)) return
            var audio = document.getElementById('podcast-audio')
            if (!audio) return
            var audioUrl = episodePlayBtn && episodePlayBtn.getAttribute('data-audio-url')
            var isCurrentEpisode = audio.src && audio.src.endsWith(audioUrl || '')
            if (!isCurrentEpisode && audioUrl && window.playEpisode) {
              var title = episodePlayBtn.getAttribute('data-episode-title') || ''
              window.playEpisode(audioUrl, title)
            }
            audio.currentTime = time
            if (audio.paused) audio.play()
            return
          }
          target = target.parentElement
        }
      })

      // Chapter seek: click chapter to jump audio
      var chapterButtons = document.querySelectorAll('.chapter-seek')
      chapterButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          var time = parseFloat(button.getAttribute('data-time'))
          if (isNaN(time)) return
          var audio = document.getElementById('podcast-audio')
          if (!audio) return
          var audioUrl = episodePlayBtn && episodePlayBtn.getAttribute('data-audio-url')
          var isCurrentEpisode = audio.src && audio.src.endsWith(audioUrl || '')
          if (!isCurrentEpisode && audioUrl && window.playEpisode) {
            var title = episodePlayBtn.getAttribute('data-episode-title') || ''
            window.playEpisode(audioUrl, title)
          }
          audio.currentTime = time
          if (audio.paused) audio.play()
        })
      })
    })()
  </script>
</Layout>

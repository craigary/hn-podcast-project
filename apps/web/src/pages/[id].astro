---
import Layout from '../layouts/Layout.astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import IconLucidePlay from '~icons/lucide/play'
import IconLucidePause from '~icons/lucide/pause'
import IconSimpleIconsYcombinator from '~icons/simple-icons/ycombinator'
import { podcastConfig } from '@hn/config'

type Episode = CollectionEntry<'episodes'>
type ShowNote = NonNullable<Episode['data']['showNotes']>[number]
type TranscriptLine = NonNullable<Episode['data']['transcript']>[number]

export async function getStaticPaths() {
  const episodes = await getCollection('episodes')
  return episodes.map((ep: Episode) => ({
    params: { id: ep.id },
    props: { episode: ep }
  }))
}

const { episode } = Astro.props as { episode: Episode }
const { id: epId, title, date, duration, audioUrl, coverImage, showNotes, transcript } = episode.data

// SEO metadata
const description = episode.data.desc || `收听 ${podcastConfig.podcast.name} 第 ${epId} 期：${title}`
const publishedTime = new Date(date).toISOString()

const episodes = await getCollection('episodes')
const sorted = episodes.sort((a: Episode, b: Episode) => b.data.id - a.data.id)
const currentIndex = sorted.findIndex((e: Episode) => e.id === episode.id)
const prevEp = sorted[currentIndex + 1]
const nextEp = sorted[currentIndex - 1]
---

<Layout
  title={`EP${epId}: ${title}`}
  description={description}
  image={coverImage}
  type="article"
  publishedTime={publishedTime}
  author={podcastConfig.podcast.name}
>
  <main class="max-w-175 mx-auto px-5 md:px-8 py-8 pb-16">
    <!-- Back link -->
    <a
      href="/"
      class="inline-block text-sm text-tx3 hover:text-tx1 transition-colors mb-8 no-underline"
    >
      ← 返回首页
    </a>

    <!-- Episode header -->
    <header class="mb-8">
      <span class="font-mono-label text-xs tracking-[0.2em] text-ac uppercase mb-4 block">EP{epId}</span>
      <div class="flex gap-6 items-start">
        {
          coverImage && (
            <Image
              src={coverImage}
              alt={title}
              width={640}
              height={640}
              loading="eager"
              class="w-32 h-32 md:w-40 md:h-40 object-cover rounded-lg shrink-0 shadow-lg"
            />
          )
        }
        <div class="flex-1 min-w-0">
          <h1 class="font-serif-display text-3xl md:text-4xl text-tx1 leading-tight mb-3">
            {title}
          </h1>
          <div class="flex items-center gap-3 font-mono-label text-xs text-tx4 mb-4">
            <time>{date}</time>
            {
              duration && (
                <>
                  <span>·</span>
                  <span>{duration}</span>
                </>
              )
            }
          </div>
          {
            audioUrl && (
              <button
                id="episode-play-btn"
                data-audio-url={audioUrl}
                data-episode-title={`EP${epId} — ${title}`}
                class="inline-flex items-center gap-2 bg-ac text-ac-on px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-ac-h transition-colors"
                aria-label={`播放单集 ${epId}: ${title}`}
              >
                <IconLucidePlay id="episode-play-icon" class="w-4 h-4" />
                <IconLucidePause id="episode-pause-icon" class="w-4 h-4 hidden" />
                <span id="episode-play-text">播放</span>
              </button>
            )
          }
        </div>
      </div>
    </header>

    <!-- Inline player area
    {audioUrl && (
      <div class="border border-bd rounded-lg p-4 mb-10 text-center">
        <p class="text-sm text-tx4">点击上方按钮开始播放</p>
      </div>
    )} -->

    <!-- Show Notes -->
    {
      showNotes && showNotes.length > 0 && (
        <section class="mb-10">
          <h2 class="font-mono-label text-xs tracking-[0.2em] text-tx4 uppercase mb-5">
            Show Notes
          </h2>
          <div class="space-y-6">
            {showNotes.map((note: ShowNote) => (
              <article class="border-l-2 border-ac/30 pl-4 hover:border-ac transition-colors">
                <a
                  href={note.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-tx1 font-medium text-base hover:text-ac transition-colors no-underline block mb-2"
                >
                  {note.title}
                </a>
                {note.desc && (
                  <p class="text-sm text-tx3 leading-relaxed mb-2">{note.desc}</p>
                )}
                <div class="flex items-center gap-3 text-xs text-tx4">
                  <a
                    href={note.hnUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-ac transition-colors no-underline inline-flex items-center gap-1"
                    aria-label={`在 Hacker News 上查看 ${note.title} 的讨论`}
                  >
                    <IconSimpleIconsYcombinator class="w-3 h-3" />
                    HN 讨论
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <!-- Transcript toggle -->
    {
      transcript && transcript.length > 0 && (
        <section class="mb-10">
          <button
            id="transcript-toggle"
            class="w-full text-left border border-bd rounded-lg px-4 py-3 text-sm text-tx2 hover:border-tx4 transition-colors"
            aria-expanded="false"
            aria-controls="transcript-content"
          >
            <span id="transcript-toggle-text">展开对话文本</span>
            <span id="transcript-toggle-icon" aria-hidden="true"> ▼</span>
          </button>
          <div id="transcript-content" class="hidden mt-4 space-y-5 px-1" role="region" aria-label="对话文本">
            {transcript.map((line: TranscriptLine) => (
              <div>
                <span class="font-medium text-ac">{line.speaker}:</span>
                <span class="text-tx2 ml-1">{line.text}</span>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Episode navigation -->
    <nav class="flex items-center justify-between border-t border-bd pt-6" aria-label="单集导航">
      {
        prevEp ? (
          <a
            href={`/${prevEp.id}`}
            class="text-sm text-tx2 hover:text-tx1 transition-colors no-underline"
            rel="prev"
          >
            ← EP{prevEp.data.id}: {prevEp.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        nextEp ? (
          <a
            href={`/${nextEp.id}`}
            class="text-sm text-tx2 hover:text-tx1 transition-colors no-underline"
            rel="next"
          >
            EP{nextEp.data.id}: {nextEp.data.title} →
          </a>
        ) : (
          <span class="text-sm text-tx4">最新一期</span>
        )
      }
    </nav>
  </main>

  <script is:inline>
    ;(function () {
      const btn = document.getElementById('transcript-toggle')
      const content = document.getElementById('transcript-content')
      const toggleText = document.getElementById('transcript-toggle-text')
      const toggleIcon = document.getElementById('transcript-toggle-icon')
      if (!btn || !content || !toggleText || !toggleIcon) return
      btn.addEventListener('click', function () {
        const isHidden = content.classList.toggle('hidden')
        btn.setAttribute('aria-expanded', isHidden ? 'false' : 'true')
        toggleText.textContent = isHidden ? '展开对话文本' : '收起对话文本'
        toggleIcon.textContent = isHidden ? ' ▼' : ' ▲'
      })
    })()
  </script>
</Layout>

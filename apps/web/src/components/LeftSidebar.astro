---
import PlatformLinks from './PlatformLinks.astro'
import SocialLinks from './SocialLinks.astro'
import IconLucideZap from '~icons/lucide/zap'
import { podcastConfig } from '@hn/config'

---

<!-- About -->
<h2 class="font-mono-label text-xs tracking-[0.2em] text-tx4 uppercase mb-5">关于</h2>

<div class="rounded-lg overflow-hidden mb-5 relative group cursor-pointer">
  <div
    class="aspect-4/3 bg-linear-to-br from-sf-dim via-sf-card to-sf relative overflow-hidden"
  >
    <div class="absolute top-6 left-6 w-3 h-3 rounded-full bg-ac/40"></div>
    <div class="absolute top-10 left-12 w-2 h-2 rounded-full bg-ac/25"></div>
    <div class="absolute top-8 right-10 w-4 h-4 rounded-full bg-tx4/20"></div>
    <div
      class="absolute inset-0 bg-linear-to-t from-(--overlay-from) via-(--overlay-mid) to-transparent"
    >
    </div>
    <div class="absolute bottom-0 left-0 right-0 p-4">
      <h3 class="font-serif-display  text-tx1 text-lg  leading-snug mb-1.5">
      {podcastConfig.podcast.tagline}
      </h3>
      <hr class="my-2 w-12 border-ac" />
      <p class="text-xs text-tx4 leading-5">
        两位 AI 主播每天精选 Hacker News 热门话题，展开深度讨论与分析。
      </p>
    </div>
  </div>
</div>

<div class="p-3 rounded-lg bg-sf-card border border-bd mb-6">
  <div class="flex items-center gap-1.5 mb-2">
    <IconLucideZap class="w-3.5 h-3.5 text-ac" />
    <span class="font-mono-label text-xs tracking-widest text-ac uppercase">AI 生成</span>
  </div>
  <p class="text-xs text-tx3 leading-relaxed">
    本播客由 AI 自动生成，包括话题筛选、对话脚本和语音合成。<a
      href="/ai"
      class="text-ac hover:text-ac-h transition-colors">了解更多 →</a
    >
  </p>
</div>

<div class="border-t border-bd my-6"></div>

<!-- 收听平台 -->
<h2 class="font-mono-label text-xs tracking-[0.2em] text-tx4 uppercase mb-4">收听平台</h2>
<div class="mb-6">
  <PlatformLinks layout="list" />
</div>

<div class="border-t border-bd my-6"></div>

<!-- 指南 -->
<h2 class="font-mono-label text-xs tracking-[0.2em] text-tx4 uppercase mb-4">指南</h2>
<div class="space-y-2.5 mb-6">
  <a
    href="/about"
    class="flex items-center gap-2 text-xs text-tx3 hover:text-tx1 transition-colors no-underline"
  >
    <span class="text-tx4">→</span> 关于本播客
  </a>
  <a
    href="/roadmap"
    class="flex items-center gap-2 text-xs text-tx3 hover:text-tx1 transition-colors no-underline"
  >
    <span class="text-tx4">→</span> 路线图 / Changelog
  </a>
  <a
    href="/how-to-listen"
    class="flex items-center gap-2 text-xs text-tx3 hover:text-tx1 transition-colors no-underline"
  >
    <span class="text-tx4">→</span> 如何收听播客
  </a>
  <a
    href="/ai"
    class="flex items-center gap-2 text-xs text-tx3 hover:text-tx1 transition-colors no-underline"
  >
    <span class="text-tx4">→</span> AI 技术说明
  </a>
</div>

<div class="border-t border-bd my-6"></div>

<!-- Social -->
<h2 class="font-mono-label text-xs tracking-[0.2em] text-tx4 uppercase mb-4">关注我们</h2>
<SocialLinks />
